# Runtime
MPT_LISTEN_HOST=0.0.0.0
MPT_LISTEN_PORT=8080
# Many platforms set PORT automatically. If present, PORT takes precedence.
# PORT=8080

# Security
# Generate a long random value and send it from your private frontend/backend proxy
# as the x-api-key header. Do not expose this value in browser-side code.
# Docker deployments require this key by default. Leave it empty locally only.
MPT_REQUIRE_API_KEY=true
MPT_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Public endpoint used in generated task URLs.
MPT_ENDPOINT=https://your-backend.example.com

# LLM provider
MPT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=

# Alternative LLM providers supported by the upstream project.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
MOONSHOT_MODEL_NAME=
GEMINI_API_KEY=
GEMINI_MODEL_NAME=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_NAME=
QWEN_API_KEY=
QWEN_MODEL_NAME=
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL_NAME=

# Stock video providers. Comma-separated values are accepted for key rotation.
PEXELS_API_KEYS=
PIXABAY_API_KEYS=
COVERR_API_KEYS=
TWELVELABS_API_KEYS=

# Redis task state and queue. REDIS_URL enables Redis automatically.
# Use redis://... or rediss://...
REDIS_URL=
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Supabase Storage. Uses the REST API with the service role key from server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mpt-videos
# Set true only when the bucket is intentionally public.
SUPABASE_STORAGE_PUBLIC=false
# Optional override for public CDN/custom domain URL construction.
SUPABASE_PUBLIC_URL_BASE=

# Speech/TTS providers
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SILICONFLOW_API_KEY=
ELEVENLABS_API_KEY=
CHATTERBOX_BASE_URL=
CHATTERBOX_API_KEY=
